# Copy to .env (never commit .env). ACCOUNT_SID/AUTH_TOKEN are injected by twilio-run.
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Registros
STUDIO_FLOW_SID=FWXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WA_SENDER=whatsapp:+5491100000000
APP_PASSCODE=change-me
# Comma-separated allowed origins (no path), e.g. Pages + local dev
ALLOWED_ORIGIN=https://youruser.github.io,http://localhost:5173
# Optional: prepended to numbers stored without country code (e.g. 54 for Argentina)
DEFAULT_COUNTRY_CODE=
